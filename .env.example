# --- LLM routing (via LiteLLM) ---
# Currently active: the free Google AI Studio tier - $0, no card required.
# Get a key at https://aistudio.google.com/apikey (sign in, accept ToS, copy
# the key shown - a Cloud project + key are created for you automatically).
GEMINI_API_KEY=

# Optional. Cross-provider fallback if Gemini's free-tier quota is exhausted.
# Get a free key at https://console.groq.com/
GROQ_API_KEY=

# Split across two different "lite" models on purpose: each model has its own
# separate free-tier daily quota bucket, so this doubles effective headroom
# versus using one model (e.g. gemini-3.6-flash, the full model) for
# everything - which has only a 20 requests/day free-tier cap, confirmed by
# hitting it during testing. Swap to gemini-3.6-flash (or newer) later for
# higher-quality generation once past free-tier testing, if desired.
GENERATOR_MODEL=gemini/gemini-3.5-flash-lite
JUDGE_MODEL=gemini/gemini-3.1-flash-lite
REWRITE_MODEL=gemini/gemini-3.1-flash-lite
GROQ_FALLBACK_MODEL=groq/llama-3.3-70b-versatile

# --- Claude, for later ---
# Once the workflow is validated end-to-end on the free Gemini tier, swapping
# to Claude is a config-only change: set ANTHROPIC_API_KEY below (a real
# Anthropic API key from https://console.anthropic.com/, pay-per-token - NOT
# the same thing as a claude.ai Pro/Max subscription login) and uncomment
# these three lines to override the Gemini ones above. No code changes needed.
ANTHROPIC_API_KEY=
# GENERATOR_MODEL=anthropic/claude-sonnet-5
# JUDGE_MODEL=anthropic/claude-haiku-4-5
# REWRITE_MODEL=anthropic/claude-haiku-4-5

# --- Local model device switching ---
# auto | cuda | cpu  (auto = cuda if available, else cpu)
EMBED_DEVICE=auto

# Leave blank to auto-select by device: Qwen/Qwen3-Embedding-0.6B on GPU,
# BAAI/bge-small-en-v1.5 on CPU. Set explicitly to override either default.
EMBED_MODEL=

RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=prabhu_chunks

# --- Storage ---
SQLITE_DB_PATH=data/app.db
INDEX_META_PATH=data/index_meta.json

# --- App/server ---
# Comma-separated list of origins allowed to call the API (the Vite dev server by default).
CORS_ALLOWED_ORIGINS=http://localhost:5173
MAX_TOOL_ITERATIONS=4
